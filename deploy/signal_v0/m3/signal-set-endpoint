#!/usr/bin/python3
import fcntl, hashlib, json, os, re, sqlite3, subprocess, sys, tempfile, uuid
from datetime import datetime, timezone
from pathlib import Path
from zoneinfo import ZoneInfo
import yaml

BILLOS = Path("/Users/billlyon/VaultHub/BillVault/Agent-Shared/BillOS")
EVENTS = BILLOS / "events"
PROCESS_EVENT = BILLOS / "bin/process-event"
RECEIPTS = BILLOS / "receipts/process-event"
CURRENT = BILLOS / "state/signal/current_signal.json"
DB = Path("/Users/billlyon/.local/state/billos-signal-endpoint/requests.sqlite")
MISSIONS = {"billos", "signalpath", "legal", "knowledgebrains", "investment"}

def canon(obj): return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
def sha(data): return hashlib.sha256(data if isinstance(data, bytes) else data.encode()).hexdigest()
def response(obj):
    obj["response_sha256"] = sha(canon(obj)); print(canon(obj)); raise SystemExit(0)
def reject(req, code, message):
    response({"version":1,"request_id":req.get("request_id"),"proposal_id":req.get("proposal_id"),"proposal_sha256":req.get("proposal_sha256"),"status":"REJECTED","applied":False,"error":{"code":code,"message":message}})

raw = sys.stdin.buffer.read(8193)
if len(raw) > 8192: reject({}, "request_too_large", "request exceeds 8192 bytes")
try: req = json.loads(raw)
except Exception: reject({}, "invalid_json", "request must be JSON")
if not isinstance(req, dict) or set(req) != {"version","operation","request_id","proposal_id","proposal_sha256","approved_by","signal"}: reject(req, "request_keys", "exact request keys required")
if req["version"] != 1 or req["operation"] != "SIGNAL_SET": reject(req, "operation", "unsupported version or operation")
try: uuid.UUID(req.get("request_id",""),version=4); uuid.UUID(req.get("proposal_id",""),version=4)
except (ValueError,TypeError,AttributeError): reject(req,"identity","request and proposal IDs must be UUIDv4")
if not re.fullmatch(r"[0-9a-f]{64}",req.get("proposal_sha256","")): reject(req,"identity","invalid proposal hash")
signal = req.get("signal")
if not isinstance(signal, dict) or set(signal) != {"actions","no_today"} or signal["no_today"] is not None: reject(req, "signal_schema", "no_today must be null")
if sha(canon(signal)) != req["proposal_sha256"]: reject(req, "proposal_hash", "proposal hash mismatch")
if not isinstance(signal["actions"], list) or len(signal["actions"]) != 3: reject(req, "action_count", "exactly three actions required")
for action in signal["actions"]:
    if not isinstance(action, dict) or set(action) != {"text","mission"}: reject(req, "action_schema", "invalid action")
    text, mission = action["text"], action["mission"]
    if not isinstance(text,str) or text != text.strip() or not 1 <= len(text) <= 200 or any(c in text for c in "|\r\n`") or text.startswith("#") or text.upper().startswith("NOT TODAY:") or mission not in MISSIONS: reject(req, "action_value", "invalid action value")
approved = req.get("approved_by")
if not isinstance(approved,dict) or set(approved) != {"platform","user_id","chat_id","proposal_message_id","approval_update_id","approval_message_id"} or approved["platform"] != "telegram" or not all(isinstance(approved[k],str) and approved[k] for k in approved): reject(req, "approval_schema", "invalid approval evidence")

DB.parent.mkdir(parents=True, exist_ok=True)
lockfd = open(str(DB) + ".lock", "a+", encoding="utf-8")
fcntl.flock(lockfd, fcntl.LOCK_EX)
db = sqlite3.connect(DB, timeout=12, isolation_level=None)
db.row_factory = sqlite3.Row
db.execute("PRAGMA journal_mode=WAL"); db.execute("PRAGMA synchronous=FULL")
db.execute("CREATE TABLE IF NOT EXISTS request(request_id TEXT PRIMARY KEY, body_sha TEXT NOT NULL, proposal_id TEXT UNIQUE NOT NULL, proposal_sha TEXT NOT NULL, event_id TEXT, response_json TEXT)")
body_sha = sha(canon(req))
db.execute("BEGIN IMMEDIATE")
row = db.execute("SELECT * FROM request WHERE request_id=? OR proposal_id=?", (req["request_id"],req["proposal_id"])).fetchone()
if row and (row["request_id"] != req["request_id"] or row["body_sha"] != body_sha): db.execute("ROLLBACK"); reject(req,"idempotency_conflict","identity reused with different content")
if row and row["response_json"]: db.execute("ROLLBACK"); print(row["response_json"]); raise SystemExit(0)
if not row: db.execute("INSERT INTO request(request_id,body_sha,proposal_id,proposal_sha) VALUES(?,?,?,?)", (req["request_id"],body_sha,req["proposal_id"],req["proposal_sha256"]))
event_id = row["event_id"] if row else None
if not event_id:
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    event_id = f"SIGNAL_SET-{stamp}-bill"
    db.execute("UPDATE request SET event_id=? WHERE request_id=?", (event_id,req["request_id"]))
db.execute("COMMIT")
event_path = EVENTS / f"{event_id}.yml"
if not event_path.exists():
    today = datetime.now(ZoneInfo("Australia/Sydney")).strftime("%Y-%m-%d")
    actions=[]
    for i,a in enumerate(signal["actions"],1):
        parts=a["text"].split(None,1); actions.append({"id":f"sig-{today.replace('-','')}-{i:02d}","verb":parts[0],"object":parts[1] if len(parts)>1 else "","source_mission":a["mission"],"done":False})
    event={"schema_version":"billos-event-v0.1","event_id":event_id,"event_type":"SIGNAL_SET","timestamp":datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),"source_agent":"christine","source_context":f"durable-signal-v0 request {req['request_id']}","mission":"signal","signal":{"date":today,"actions":actions,"no_today":""},"requires_human_review":False,"confidence":"high"}
    fd,tmp=tempfile.mkstemp(prefix=".signal-",dir=EVENTS); os.close(fd)
    Path(tmp).write_text(yaml.safe_dump(event,sort_keys=False,allow_unicode=True,width=100),encoding="utf-8"); os.chmod(tmp,0o644); os.replace(tmp,event_path)
receipts=sorted(RECEIPTS.glob(f"{event_id}.*.txt"))
if not receipts:
    run=subprocess.run([str(PROCESS_EVENT),"--event",event_id],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=10)
    receipts=sorted(RECEIPTS.glob(f"{event_id}.*.txt"))
    if run.returncode and not receipts: reject(req,"process_event_rejected",(run.stderr or run.stdout)[-500:])
if len(receipts)!=1 or not CURRENT.exists(): reject(req,"receipt_missing","process receipt not uniquely verifiable")
receipt=receipts[0]
out={"version":1,"request_id":req["request_id"],"proposal_id":req["proposal_id"],"proposal_sha256":req["proposal_sha256"],"status":"APPLIED","event_id":event_id,"event_type":"SIGNAL_SET","event_created_at":datetime.fromtimestamp(event_path.stat().st_mtime,timezone.utc).isoformat(),"applied_at":datetime.fromtimestamp(receipt.stat().st_mtime,timezone.utc).isoformat(),"process_receipt":{"receipt_id":receipt.name,"receipt_sha256":sha(receipt.read_bytes()),"canonical_state_sha256":sha(CURRENT.read_bytes())}}
out["response_sha256"]=sha(canon(out)); encoded=canon(out)
db.execute("UPDATE request SET response_json=? WHERE request_id=?",(encoded,req["request_id"])); print(encoded)
